# ─────────────────────────────────────────────────────────────
# Next.js (.env.local) — public values only
# ─────────────────────────────────────────────────────────────

# Convex deployment URL (written automatically by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Set by `npx convex dev` as well; used by the Convex CLI only
CONVEX_DEPLOYMENT=dev:your-deployment

# Public site URL (canonical URLs, sitemap, hreflang, Open Graph).
# Can be overridden from Admin → SEO → "URL canonique du site".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Convex deployment environment — NOT in .env.local!
# Set these with `npx convex env set NAME value` (add --prod for production).
# Secrets never reach the browser.
# ─────────────────────────────────────────────────────────────

# Convex Auth (generate with: npm run auth:keys)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ..."
# JWKS={"keys":[...]}
# SITE_URL=http://localhost:3000

# Cloudinary (signed uploads + deletions happen in Convex actions)
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx
# CLOUDINARY_FOLDER=electro-ikram          # optional, default "electro-ikram"

# Electro Darna link (Admin → Electro Darna: clone products, stock synced every 15 min)
# ELECTRODARNA_API_URL=https://<deployment>.convex.site   # Electro Darna's Convex site URL
# ELECTRODARNA_API_KEY=xxxxxxxx                           # = CATALOG_SHARE_KEY in Electro Darna's Convex env

# Resend (password-reset codes + new-order e-mail notifications) — optional
# AUTH_RESEND_KEY=re_xxxxxxxx
# AUTH_EMAIL_FROM="Electro-Ikram <no-reply@your-domain.ma>"
